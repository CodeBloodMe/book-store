datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

// PostgreSQL enforces the declared foreign keys. Supabase Auth remains the
// identity provider; public.users is the application profile/role table.
model User {
  id         String   @id @db.Uuid
  email      String   @unique
  role       String   @default("User")
  created_at DateTime @default(now()) @db.Timestamptz
  updated_at DateTime @default(now()) @db.Timestamptz

  reviews Review[]
  shelves UserShelf[]

  @@map("users")
}

model Book {
  id                  String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  title               String
  page_count          Int?
  external_id         String?  @unique
  author              String?
  expert_rating       Decimal?
  community_rating    Decimal?
  genre_id            String   @db.Uuid
  series_name         String?  @db.VarChar(255)
  series_number       Int?
  user_review_average Decimal  @default(0) @db.Decimal(3, 2)
  user_review_count   Int      @default(0)

  genre                Genre                  @relation(fields: [genre_id], references: [id], onDelete: Restrict)
  reviews              Review[]
  shelves              UserShelf[]
  interactions         BlindDateInteraction[]
  edgesFrom            BookEdge[]             @relation("BookEdgeFrom")
  edgesTo              BookEdge[]             @relation("BookEdgeTo")
  currentMatchProfiles UserReaderProfile[]    @relation("ProfileCurrentMatch")

  @@index([genre_id])
  @@map("books")
}

model Review {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  book_id       String   @db.Uuid
  reviewer_name String   @db.VarChar
  rating        Int
  content       String
  created_at    DateTime @default(now()) @db.Timestamptz
  user_id       String?  @db.Uuid

  user User? @relation(fields: [user_id], references: [id], onDelete: SetNull)
  book Book  @relation(fields: [book_id], references: [id], onDelete: Cascade)

  @@index([user_id])
  @@index([book_id])
  @@index([created_at(sort: Desc)])
  @@map("reviews")
}

model UserShelf {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id    String   @db.Uuid
  book_id    String   @db.Uuid
  status     String   @db.VarChar(50)
  created_at DateTime @default(now()) @db.Timestamptz
  updated_at DateTime @default(now()) @db.Timestamptz

  user User @relation(fields: [user_id], references: [id], onDelete: Cascade)
  book Book @relation(fields: [book_id], references: [id], onDelete: Cascade)

  @@unique([user_id, book_id])
  @@index([user_id])
  @@index([book_id])
  @@map("user_shelves")
}

model Genre {
  id                String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name              String
  super_category_id String @db.Uuid

  superCategory SuperCategory @relation(fields: [super_category_id], references: [id])
  books         Book[]

  @@index([super_category_id])
  @@map("genres")
}

model SuperCategory {
  id     String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name   String
  genres Genre[]

  @@map("super_categories")
}

model Author {
  id              String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name            String    @unique
  ai_bio          String?
  ai_style        String[]
  ai_last_updated DateTime? @db.Timestamptz
  created_at      DateTime  @default(now()) @db.Timestamptz
  updated_at      DateTime  @default(now()) @db.Timestamptz

  @@map("authors")
}

model BookEdge {
  id                String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  book_a_id         String   @db.Uuid
  book_b_id         String   @db.Uuid
  weight            Float    @default(1.0)
  relationship_type String   @db.VarChar(50)
  evidence          Json?
  similarity_score  Float?
  algorithm_version String?  @db.VarChar(50)
  created_at        DateTime @default(now()) @db.Timestamptz

  bookA Book @relation("BookEdgeFrom", fields: [book_a_id], references: [id], onDelete: Cascade)
  bookB Book @relation("BookEdgeTo", fields: [book_b_id], references: [id], onDelete: Cascade)

  @@unique([book_a_id, book_b_id])
  @@index([book_a_id])
  @@index([book_b_id])
  @@index([relationship_type])
  @@map("book_edges")
}

model UserReaderProfile {
  id                    String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  session_id            String   @unique
  mood                  String?  @db.VarChar(50)
  pace_preference       String?  @db.VarChar(50)
  complexity_preference String?  @db.VarChar(50)
  era_preference        String?  @db.VarChar(50)
  length_preference     String?  @db.VarChar(50)
  last_matched_book_id  String?  @db.Uuid
  created_at            DateTime @default(now()) @db.Timestamptz

  lastMatchedBook Book? @relation("ProfileCurrentMatch", fields: [last_matched_book_id], references: [id], onDelete: SetNull)

  @@map("user_reader_profiles")
}

model BlindDateInteraction {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  session_id String
  book_id    String   @db.Uuid
  accepted   Boolean
  created_at DateTime @default(now()) @db.Timestamptz

  book Book @relation(fields: [book_id], references: [id], onDelete: Cascade)

  @@index([book_id])
  @@index([session_id])
  @@index([accepted])
  @@map("blind_date_interactions")
}
