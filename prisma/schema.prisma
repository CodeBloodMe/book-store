datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  relationMode = "prisma"
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email      String   @unique
  role       String   @default("User")
  created_at DateTime @default(now())

  reviews    Review[]
  shelves    UserShelf[]

  @@map("users")
}

model Book {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  title       String
  page_count  Int?
  external_id String?  @unique
  author      String?  
  
  reviews     Review[]
  shelves     UserShelf[]

  @@map("books")
}

model Review {
  id      String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id String @db.Uuid
  book_id String @db.Uuid
  rating  Int
  content String

  user    User   @relation(fields: [user_id], references: [id])
  book    Book   @relation(fields: [book_id], references: [id])

  @@index([user_id])
  @@index([book_id])
  @@map("reviews")
}

model UserShelf {
  id      String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id String @db.Uuid
  book_id String @db.Uuid
  status  String

  user    User   @relation(fields: [user_id], references: [id])
  book    Book   @relation(fields: [book_id], references: [id])

  @@unique([user_id, book_id])
  @@index([user_id])
  @@index([book_id])
  @@map("user_shelves")
}

model Genre {
  id                String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name              String
  super_category_id String @db.Uuid
  superCategory     SuperCategory @relation(fields: [super_category_id], references: [id])

  @@index([super_category_id])
  @@map("genres")
}

model SuperCategory {
  id     String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name   String
  genres Genre[]

  @@map("super_categories")
}

model Author {
  id       String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name     String @unique
  ai_bio   String?
  ai_style String[]

  @@map("authors")
}

model BookEdge {
  book_a_id         String   @db.Uuid
  book_b_id         String   @db.Uuid
  weight            Float
  relationship_type String
  evidence          String?
  similarity_score  Float?
  created_at        DateTime @default(now())

  @@unique([book_a_id, book_b_id])
  @@index([book_a_id])
  @@index([book_b_id])
  @@map("book_edges")
}

model UserReaderProfile {
  session_id String @id
  mood       String

  @@map("user_reader_profiles")
}

model BlindDateInteraction {
  id         String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  session_id String 
  book_id    String @db.Uuid
  action     String

  @@map("blind_date_interactions")
}
