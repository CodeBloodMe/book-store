# Public project configuration: safe to expose with correctly configured RLS.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=replace-with-supabase-publishable-or-anon-key

# Server-only secrets. NEVER prefix these with NEXT_PUBLIC_ or commit actual values.
SUPABASE_SECRET_KEY=sb_secret_replace_this_on_server_only
# Older projects can use SUPABASE_SERVICE_ROLE_KEY until keys are migrated.
# SUPABASE_SERVICE_ROLE_KEY=replace-with-legacy-server-only-service-role-key
CRON_SECRET=generate-a-different-random-secret-of-at-least-32-characters
DATABASE_URL=postgresql://USER:PASSWORD@HOST:PORT/DATABASE?sslmode=require
GEMINI_API_KEY=replace-with-ai-provider-key
GROQ_API_KEY=replace-with-ai-provider-key
OPENAI_API_KEY=replace-with-ai-provider-key
